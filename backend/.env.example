# ──────────────────────────────────────────────────────────────────────────────
# E-Rakshak AI — Backend Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
#
# INSTRUCTIONS
# ------------
# 1. Copy this file to `.env` in the backend/ directory:
#      cp .env.example .env
# 2. Replace placeholder values with your actual configuration.
# 3. NEVER commit the resulting .env file to version control.
#
# ──────────────────────────────────────────────────────────────────────────────

# Application
APP_NAME=E-Rakshak AI
APP_ENV=development
API_VERSION=0.1.0

# Database (Supabase Managed PostgreSQL)
# Replace with your Supabase Transaction connection string (port 6543) or Session connection string (port 5432)
# Ensure you use postgresql+asyncpg:// format
DATABASE_URL=postgresql+asyncpg://postgres.your-project:your_password@aws-0-region.pooler.supabase.com:6543/postgres

# Supabase API Settings (for future frontend/client use, or backend SDK)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key

# CORS
# URL of the Next.js frontend (used to whitelist CORS origins).
FRONTEND_URL=http://localhost:3000
