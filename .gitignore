# E-Rakshak AI — .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Secrets & environment files ───────────────────────────────────────────────
**/.env
**/.env.local
**/.env.*.local
!**/.env.example

# ── Node / Next.js ────────────────────────────────────────────────────────────
node_modules/
.next/
out/
dist/
build/
.npm
.eslintcache

# ── Python / FastAPI ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
wheels/
pip-wheel-metadata/
share/python-wheels/
lib/
lib64/
include/
bin/

# Virtual environments
venv/
.venv/
env/
ENV/
.env/
.venv*

# pytest / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# mypy / ruff
.mypy_cache/
.ruff_cache/

# ── IDE / editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.db
*.sqlite
*.sqlite3
# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Desktop.ini
